{
  "name": "cezane",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "serve": "bun packages/server/src/cli.ts serve",
    "cezane": "bun packages/server/src/cli.ts",
    "app": "bun --cwd packages/app run electron",
    "build:ui": "bun --cwd packages/app run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
