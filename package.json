{
  "name": "cezane",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "serve": "bun packages/server/src/cli.ts serve",
    "cezane": "bun packages/server/src/cli.ts",
    "app": "cd packages/app && bun run electron",
    "build:ui": "cd packages/app && bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "shot": "bun packages/engine/scripts/shot.ts",
    "install:mac": "bun packages/app/scripts/install-mac.ts",
    "release:mac": "bun packages/app/scripts/release-mac.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}