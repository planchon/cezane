{
  "name": "@cezane/app",
  "version": "0.2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "bun run build:electron && electron .",
    "build:electron": "bun build ./electron/main.ts --target=node --format=cjs -e electron --outfile dist-electron/main.cjs && bun build ./electron/preload.ts --target=node --format=cjs -e electron --outfile dist-electron/preload.cjs"
  },
  "dependencies": {
    "@cezane/core": "workspace:*",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "lucide-react": "^1.73.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldraw": "^5.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "vite": "^8.3.8"
  }
}
